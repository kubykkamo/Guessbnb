        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS {\n        int id PK\n        string auth0_id \&quot;Unikátní ID z Auth0 (Unique)\&quot;\n        string username \&quot;Zobrazované jméno\&quot;\n        int global_score \&quot;Kumulativní skóre\&quot;\n        datetime created_at\n    }\n\n    LISTINGS {\n        int id PK\n        string external_id \&quot;ID z Inside Airbnb (Unique)\&quot;\n        string city \&quot;Filtr (Praha, Vídeň...)\&quot;\n        string name \&quot;Název (např. Cozy Apartment)\&quot;\n        string property_type \&quot;Typ (Entire home, Room)\&quot;\n        int accommodates \&quot;Kapacita osob\&quot;\n        int bedrooms \&quot;Počet ložnic\&quot;\n        float rating \&quot;Průměrné hodnocení (např. 4.85)\&quot;\n        int reviews_count \&quot;Počet hodnocení\&quot;\n        float price \&quot;Cílová cena za noc\&quot;\n    }\n\n    PHOTOS {\n        int id PK\n        int listing_id FK \&quot;Vazba na ubytování (LISTINGS.id)\&quot;\n        string image_url \&quot;Odkaz na S3/R2 úložiště\&quot;\n        int display_order \&quot;Pořadí zobrazení (1, 2, 3...)\&quot;\n    }\n\n    %% Definice vztahu: Jedno ubytování MÁ jednu nebo více fotek\n    LISTINGS ||--|{ PHOTOS : \&quot;obsahuje\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JBN5Xvm2kFAPcRJFkbAj-91">

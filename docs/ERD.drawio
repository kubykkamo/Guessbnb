        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS {\n        int id PK\n        string auth0_id \&quot;Unikátní ID z Auth0 (Unique)\&quot;\n        string username \&quot;Zobrazované jméno\&quot;\n        int global_score \&quot;Kumulativní skóre\&quot;\n        datetime created_at\n    }\n\n    LISTINGS {\n        int id PK\n        string external_id \&quot;ID z Inside Airbnb (Unique)\&quot;\n        string city \&quot;Filtr (Prague, New York...)\&quot;\n        string country \&quot;Země na kartě (Czechia, United States)\&quot;\n        string neighbourhood \&quot;Čtvrť (Praha 1-22, Libuš...)\&quot;\n        float latitude \&quot;Šířka z CSV (na mapu, ne na měření)\&quot;\n        float longitude \&quot;Délka z CSV (na mapu, ne na měření)\&quot;\n        string name \&quot;Název (např. Cozy Apartment)\&quot;\n        string property_type \&quot;Typ (Entire home, Room)\&quot;\n        string room_type \&quot;Entire home/apt / Private room / Hotel room\&quot;\n        int accommodates \&quot;Kapacita osob\&quot;\n        int bedrooms \&quot;Počet ložnic\&quot;\n        int beds \&quot;Počet postelí\&quot;\n        float bathrooms \&quot;Počet koupelen (1,5 = 1 a půl)\&quot;\n        float rating \&quot;Průměrné hodnocení (např. 4.85)\&quot;\n        int reviews_count \&quot;Počet hodnocení\&quot;\n        float price \&quot;Cílová cena za noc, vždy v CZK\&quot;\n    }\n\n    PHOTOS {\n        int id PK\n        int listing_id FK \&quot;Vazba na ubytování (LISTINGS.id)\&quot;\n        string image_url \&quot;Odkaz na S3/R2 úložiště\&quot;\n        int display_order \&quot;Pořadí zobrazení (1, 2, 3...)\&quot;\n    }\n\n    %% Definice vztahu: Jedno ubytování MÁ jednu nebo více fotek\n    LISTINGS ||--|{ PHOTOS : \&quot;obsahuje\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JBN5Xvm2kFAPcRJFkbAj-91">
